# -----------------------------------------------------------
# REGRAS DE JSON (ADF vs PBI vs DATA/CACHE)
# -----------------------------------------------------------
# 1. Bloqueia TODOS os JSONs por padrão (garante que data/ e cache/ sejam ignorados)
*.json

# 2. Libera (Allowlist) JSONs do Azure Data Factory (ADF)
# (Cobre tanto na raiz quanto em subpastas)
!**/dataset/*.json
!**/factory/*.json
!**/linkedService/*.json
!**/pipeline/*.json
!**/trigger/*.json
!**/integrationRuntime/*.json
!**/dataFlow/*.json
!**/ADF/**/*.json 

# 3. Libera (Allowlist) JSONs de Estrutura do Power BI (PBIP)
!**/*.Report/**/*.json
!**/*.SemanticModel/**/*.json
!**/*.pbip
!**/PBI/**/*.json 

# 4. Libera (Allowlist) de Estrutura do Databricks
!**/ADB/**/*.json 

# -----------------------------------------------------------

# Pastas especificas de Dados e Cache para garantir
/data/
**/cache/
**/.pbi/cache.abf
**/.pbi/localSettings.json

# MLflow
mlruns/

# IDE specific
.vscode/
.idea/
*.iml

# OS generated files
.DS_Store
Thumbs.db