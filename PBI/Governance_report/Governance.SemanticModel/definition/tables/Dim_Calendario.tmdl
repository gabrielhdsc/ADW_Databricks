	partition Dim_Calendario = calculated
		mode: import
		source = ```
				
				ADDCOLUMNS (
				    // Define o período: De 1 de Janeiro de 2020 até 31 de Dezembro de 2030
				    CALENDAR ( DATE(2020, 1, 1), DATE(2030, 12, 31) ),
				    
				    "DateKey", VALUE(FORMAT([Date], "YYYYMMDD")),
				    "FullDate", [Date],
				    "DayNumberOfWeek", WEEKDAY([Date], 1), // 1 = Domingo, 7 = Sábado
				    "DayNameOfWeek", FORMAT([Date], "dddd"),
				    "DayNumberOfMonth", DAY([Date]),
				    "MonthNumberOfYear", MONTH([Date]),
				    "MonthName", FORMAT([Date], "MMMM"),
				    "CalendarQuarter", QUARTER([Date]),
				    "CalendarYear", YEAR([Date]),
				    "IsWeekend", IF(WEEKDAY([Date], 2) >= 6, 1, 0) // 2: Seg=1, então Sáb=6 e Dom=7
				)
				```

	annotation PBI_Id = 11e2519acc8d4fe199ae39c7133847ad

