model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["fact_purchases","dim_product","dim_location","fact_sales_order_detail","fact_sales_order","dim_date","dim_territory"]

annotation PBI_ProTooling = ["DevMode"]

ref table fact_purchases
ref table dim_product
ref table dim_location
ref table fact_sales_order_detail
ref table fact_sales_order
ref table dim_date
ref table _Measures
ref table dim_territory

ref cultureInfo pt-BR

