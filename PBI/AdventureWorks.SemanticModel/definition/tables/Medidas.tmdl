	measure 'Fixed Costs' = [Total Sales] - [Variable Costs]
		lineageTag: 15475290-2f17-4879-9da3-14d556120ad6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Top Clientes' = ```
			
