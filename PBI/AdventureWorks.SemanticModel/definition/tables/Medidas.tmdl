	measure Expense = [Total ShipCost] + [Total TaxAmt]
		lineageTag: 2e6a3281-29a5-471e-9cc2-9f66fe0800f3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Operating Revenues' = ```
			
