		lineageTag: 82bc165f-8c69-423a-9d6f-52024e792ad4

	measure 'Sales Previous Month' = ```
			
			CALCULATE (
			    [Total Sales],
			    PREVIOUSMONTH ( Calendar[Date] )
			)
			
			```
		lineageTag: bd855aac-9a6f-4c83-a25d-eea56bb7c751

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sales MoM Difference' = ```
			
