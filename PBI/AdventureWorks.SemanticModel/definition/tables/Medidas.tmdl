			```
		lineageTag: a237a7a3-a595-4638-8b18-a8a4ad2d3a75

	measure 'Total Units Sold' = ```
			
			SUM ( fact_sales[OrderQty] )
			
			```
		formatString: 0
		lineageTag: b078e13f-a3c5-4a87-8244-b668ad2fd81b

	measure 'Total Cost' = ```
			
			SUMX (
			    Fact_Sales,
			    fact_sales[OrderQty]
			        * RELATED ( Dim_Product[StandardCost] )
			)
			
			```
		lineageTag: e5870675-00fd-40b1-ad75-9db158bd80e3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Profit' = ```
			
			[Total Sales] - [Total Cost]
			
			```
		lineageTag: 04f402c5-aeb4-4515-9bc9-74fca8a951c4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Product Rank' = ```
			
			RANKX (
			    ALL ( Dim_Product[ProductName] ),
			    [Total Sales],
			    ,
			    DESC
			)
			
			```
		formatString: 0
		lineageTag: f7c22f6a-b2ec-4043-b34d-2e8179babe8a

	measure 'Profit Margin %' = ```
			
			DIVIDE (
			    [Total Profit],
