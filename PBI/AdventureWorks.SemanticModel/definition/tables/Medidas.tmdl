		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total ShipCost' = SUM(vwsalesforbi[ShippingCost])
		lineageTag: 93ac12ed-d181-441e-a593-6bbb98a1885e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total TaxAmt' = SUM(vwsalesforbi[TaxAmount])
